# Shared service configuration
INFERSCALE_ENV=development
INFERSCALE_LOG_LEVEL=info
INFERSCALE_HTTP_ADDR=:8080
INFERSCALE_GRPC_ADDR=:9001
INFERSCALE_METRICS_ADDR=:9090
INFERSCALE_DATABASE_URL=postgres://inferscale:inferscale@localhost:5432/inferscale?sslmode=disable
INFERSCALE_VALKEY_ADDR=localhost:6379
# Optional managed Valkey URL; takes precedence over VALKEY_ADDR. Keep in a
# Secret, percent-encode username/password, and use rediss for verified TLS.
INFERSCALE_VALKEY_URL=
# Exact API endpoint addresses for tenant EPP access after k3s service DNAT.
# Leave empty/default for local portability; a non-443 port requires addresses.
INFERSCALE_KUBERNETES_API_CIDRS=
INFERSCALE_KUBERNETES_API_PORT=443
INFERSCALE_PROMETHEUS_URL=http://localhost:9090
INFERSCALE_OTLP_ENDPOINT=http://localhost:4317
INFERSCALE_USAGE_AGGREGATION_INTERVAL=5m
INFERSCALE_USAGE_LOOKBACK_HOURS=2

# Kubernetes and runtime configuration
INFERSCALE_KUBECONFIG=
INFERSCALE_CONTROL_NAMESPACE=inferscale-system
INFERSCALE_GATEWAY_NAME=inferscale
INFERSCALE_GATEWAY_NAMESPACE=inferscale-gateway
INFERSCALE_MONITORING_NAMESPACE=inferscale-monitoring
INFERSCALE_PUBLIC_BASE_URL=http://127.0.0.1:8080
INFERSCALE_MODEL_CACHE_ROOT=/var/lib/inferscale/models
INFERSCALE_ENGINE_CACHE_ROOT=/var/lib/inferscale/engines
INFERSCALE_VLLM_IMAGE=ghcr.io/inferscale/vllm:0.1.0-dev
INFERSCALE_VLLM_VERSION=0.23.0
# Local control-plane only. When true, the controller renders the CPU fake
# server under the public vLLM backend contract and skips model prefetch.
INFERSCALE_FAKE_RUNTIME=false
INFERSCALE_TRTLLM_IMAGE=ghcr.io/inferscale/trtllm:0.1.0-dev
INFERSCALE_TRTLLM_VERSION=1.0.0
INFERSCALE_PREFETCH_IMAGE=ghcr.io/inferscale/modelcache:0.1.0-dev
INFERSCALE_EPP_IMAGE=ghcr.io/llm-d/llm-d-router-endpoint-picker@sha256:873179822ab0895a37ea09f2112ca39a6ae50a26612561c8bfad7f9a8c5af6f5
INFERSCALE_BENCHMARK_IMAGE=ghcr.io/inferscale/benchmark:0.1.0-dev
INFERSCALE_BENCHMARK_CALLBACK_URL=http://inferscale-api.inferscale-system.svc.cluster.local:8080
INFERSCALE_BENCHMARK_CALLBACK_SIGNING_KEY=
INFERSCALE_BENCHMARK_RESULTS_PVC=
INFERSCALE_BENCHMARK_PROVIDER=
INFERSCALE_BENCHMARK_INFERENCE_BASE_URL=http://127.0.0.1:8080
INFERSCALE_BENCHMARK_PROMETHEUS_URL=http://localhost:9090
INFERSCALE_BENCHMARK_DRIVER_VERSION=
INFERSCALE_BENCHMARK_CUDA_VERSION=

# Feature gates remain disabled until their milestone suites pass.
INFERSCALE_FEATURE_SCALE_TO_ZERO=false
INFERSCALE_FEATURE_PROGRESSIVE_ROLLOUT=false
INFERSCALE_FEATURE_TRTLLM=false
INFERSCALE_FEATURE_BACKEND_AUTO=false
# Required exact environment keys before backend:auto may be enabled.
INFERSCALE_DRIVER_CUDA_FINGERPRINT=
INFERSCALE_SELECTION_SCENARIO_DIGEST=

# Direct local baseline (never publishable)
INFERSCALE_LOCAL_MODEL=Qwen/Qwen3-0.6B
INFERSCALE_LOCAL_MODEL_REVISION=
HF_TOKEN=
