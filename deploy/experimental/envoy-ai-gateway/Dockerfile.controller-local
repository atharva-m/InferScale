# syntax=docker/dockerfile:1.9
# Build context: extension-review/upstream/agent-router-0.7.0 only.
# Use the root agent's existing CPU/memory-capped builder, serially.
ARG GO_IMAGE=golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

FROM ${GO_IMAGE} AS build
ENV GOMAXPROCS=2 GOMEMLIMIT=1GiB CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS="-p=2 -mod=readonly"
WORKDIR /src
COPY go.mod go.sum ./
# All dependency downloads happen here, once, using the pinned module sums.
RUN --mount=type=cache,target=/go/pkg/mod \
    sha256sum go.mod go.sum > /tmp/module-inputs.sha256 && \
    go mod download && go mod verify && sha256sum -c /tmp/module-inputs.sha256
COPY . .
RUN --network=none --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go test -p=1 -count=1 -timeout=5m ./internal/extensionserver
RUN --network=none --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/controller ./cmd/controller && \
    sha256sum -c /tmp/module-inputs.sha256

FROM ${RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="InferScale local test Envoy AI Gateway controller" \
      org.opencontainers.image.version="v0.7.0-local-epp-dedup" \
      io.inferscale.validation="nonpublishable local dependency experiment"
COPY --from=build /out/controller /app
USER 65532:65532
ENTRYPOINT ["/app"]
