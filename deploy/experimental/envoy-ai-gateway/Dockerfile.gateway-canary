# syntax=docker/dockerfile:1.9
# Context: verified patched github.com/envoyproxy/gateway v1.8.1 source.
# Build this and the addon serially on the resource-capped builder.
ARG GO_IMAGE=golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a
FROM ${GO_IMAGE} AS build
ENV GOMAXPROCS=2 GOMEMLIMIT=1GiB CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS="-p=2 -mod=readonly"
WORKDIR /src
COPY go.mod go.sum ./
# Keep verified modules in this layer so offline tests survive BuildKit cache GC.
RUN \
    sha256sum go.mod go.sum > /tmp/module-inputs.sha256 && \
    go mod download && go mod verify && sha256sum -c /tmp/module-inputs.sha256
COPY . .
RUN --network=none \
    --mount=type=cache,target=/root/.cache/go-build \
    go test -p=1 -count=1 -timeout=10m ./internal/gatewayapi ./internal/ir ./internal/xds/translator
RUN --network=none \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/envoy-gateway ./cmd/envoy-gateway && \
    sha256sum -c /tmp/module-inputs.sha256
FROM ${RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="InferScale Envoy Gateway canary qualification candidate" \
      org.opencontainers.image.version="v1.8.1-inferscale-canary" \
      io.inferscale.validation="requires recorded live Gateway conformance"
COPY --from=build /out/envoy-gateway /usr/local/bin/envoy-gateway
USER 65532:65532
ENTRYPOINT ["envoy-gateway"]
