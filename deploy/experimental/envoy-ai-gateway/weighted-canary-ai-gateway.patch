+func TestSetupCacheSecretNamespaces(t *testing.T) {
+	for _, tc := range []struct {
+		name              string
+		args              []string
+		defaultNamespaces map[string]cache.Config
+	}{
+		{
+			name: "all tenant pools with restricted secrets",
+			args: []string{"--watchNamespaces=", "--secretNamespaces=envoy-ai-gateway-system,inferscale-gateway"},
+		},
+		{
+			name: "restricted secrets do not change other resource namespaces",
+			args: []string{"--watchNamespaces=tenant-a,tenant-b", "--secretNamespaces=envoy-ai-gateway-system,inferscale-gateway"},
+			defaultNamespaces: map[string]cache.Config{
+				"tenant-a": {},
+				"tenant-b": {},
+			},
+		},
+		{
+			name: "duplicate and empty entries cannot enable all namespace secrets",
+			args: []string{"--secretNamespaces=envoy-ai-gateway-system,,inferscale-gateway,inferscale-gateway,"},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f, err := parseAndValidateFlags(tc.args)
+			require.NoError(t, err)
+			c := setupCache(f)
+			require.NotNil(t, c.DefaultTransform)
+			require.Equal(t, tc.defaultNamespaces, c.DefaultNamespaces)
+			// Only Secrets receive an override; InferencePools and all other
+			// resources still use DefaultNamespaces, including future tenants.
+			require.Len(t, c.ByObject, 1)
+			for object, options := range c.ByObject {
+				require.IsType(t, &corev1.Secret{}, object)
+				require.Equal(t, map[string]cache.Config{
+					"envoy-ai-gateway-system": {},
+					"inferscale-gateway":      {},
+				}, options.Namespaces)
+				require.NotContains(t, options.Namespaces, cache.AllNamespaces)
+			}
+		})
+	}
+}
