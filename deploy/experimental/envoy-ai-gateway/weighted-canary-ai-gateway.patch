+func TestWeightedInferencePoolsPreserveCanaryAndAuthContract(t *testing.T) {
+	createInferencePool := func(name, namespace string) *gwaiev1.InferencePool {
+		return &gwaiev1.InferencePool{
+			ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: namespace},
+			Spec: gwaiev1.InferencePoolSpec{
+				TargetPorts:       []gwaiev1.Port{{Number: 8000}},
+				EndpointPickerRef: gwaiev1.EndpointPickerRef{Name: gwaiev1.ObjectName(name + "-epp")},
+			},
+		}
+	}
+	createListener := func(name, routeConfigName string) *listenerv3.Listener {
+		config := &hcmv3.HttpConnectionManager{
+			RouteSpecifier: &hcmv3.HttpConnectionManager_Rds{Rds: &hcmv3.Rds{RouteConfigName: routeConfigName}},
+			HttpFilters:    []*hcmv3.HttpFilter{{Name: "envoy.filters.http.router"}},
+		}
+		return &listenerv3.Listener{Name: name, DefaultFilterChain: &listenerv3.FilterChain{
+			Filters: []*listenerv3.Filter{{Name: "envoy.filters.network.http_connection_manager", ConfigType: &listenerv3.Filter_TypedConfig{TypedConfig: mustToAny(t, config)}}},
+		}}
+	}
+	s, err := New(newFakeClient(), logr.Discard(), udsPath, false, nil, nil, "ratelimit", 5, false)
+	require.NoError(t, err)
+	pools := []*gwaiev1.InferencePool{createInferencePool("stable", "tenant"), createInferencePool("candidate", "tenant")}
+	clusters := []*clusterv3.Cluster{{Name: "arbitrary-cluster-A"}, {Name: "arbitrary-cluster-B"}}
+	for i, pool := range pools {
+		s.handleInferencePoolCluster(clusters[i], pool)
+		require.NotNil(t, getInferencePoolByMetadata(clusters[i].Metadata), "nil input metadata must persist")
+	}
+	duplicatedClusters := append(append([]*clusterv3.Cluster{}, clusters...), clusters...)
+	eppClusters, err := buildClustersForInferencePoolEndpointPickers(duplicatedClusters)
+	require.NoError(t, err)
+	require.Len(t, eppClusters, 2, "priority rules share one upstream EPP cluster per pool")
+	again, err := buildClustersForInferencePoolEndpointPickers(append(duplicatedClusters, eppClusters...))
+	require.NoError(t, err)
+	require.Empty(t, again, "translation does not add existing EPP clusters")
+	var priorityRoutes []*routev3.Route
+	for _, priority := range []string{"interactive", "standard", "batch", "default"} {
+		backends := []*routev3.WeightedCluster_ClusterWeight{}
+		for i, cluster := range clusters {
+			weight := uint32(95)
+			if i == 1 {
+				weight = 5
+			}
+			backends = append(backends, &routev3.WeightedCluster_ClusterWeight{
+				Name: cluster.Name, Weight: wrapperspb.UInt32(weight),
+				RequestHeadersToAdd: []*corev3.HeaderValueOption{{
+					Header:       &corev3.HeaderValue{Key: inferenceObjectiveHeader, Value: pools[i].Name + "-" + priority},
+					AppendAction: corev3.HeaderValueOption_OVERWRITE_IF_EXISTS_OR_ADD,
+				}},
+			})
+		}
+		priorityRoutes = append(priorityRoutes, &routev3.Route{
+			Name:  priority,
+			Match: &routev3.RouteMatch{PathSpecifier: &routev3.RouteMatch_Path{Path: "/v1/deployments/demo/chat/completions"}},
+			Action: &routev3.Route_Route{Route: &routev3.RouteAction{
+				ClusterSpecifier: &routev3.RouteAction_WeightedClusters{WeightedClusters: &routev3.WeightedCluster{Clusters: backends}},
+				PrefixRewrite:    "/v1/chat/completions",
+				RequestMirrorPolicies: []*routev3.RouteAction_RequestMirrorPolicy{{
+					Cluster:         "candidate-runtime-service",
+					RuntimeFraction: &corev3.RuntimeFractionalPercent{DefaultValue: &typev3.FractionalPercent{Numerator: 7, Denominator: typev3.FractionalPercent_HUNDRED}},
+				}},
+			}},
+		})
+	}
+	unrelated := &routev3.Route{Name: "unrelated"}
+	routes := []*routev3.RouteConfiguration{{Name: "routes", VirtualHosts: []*routev3.VirtualHost{{Name: "host", Routes: append(priorityRoutes, unrelated)}}}}
+	listener := createListener("listener", "routes")
+	hcm := &hcmv3.HttpConnectionManager{}
+	require.NoError(t, listener.DefaultFilterChain.Filters[0].GetTypedConfig().UnmarshalTo(hcm))
+	hcm.HttpFilters = append([]*hcmv3.HttpFilter{{Name: "envoy.filters.http.ext_authz"}}, hcm.HttpFilters...)
+	listener.DefaultFilterChain.Filters[0].ConfigType = &listenerv3.Filter_TypedConfig{TypedConfig: mustToAny(t, hcm)}
+	for range 2 {
+		require.NoError(t, prepareWeightedInferencePoolRoutes(clusters, routes))
+		require.NoError(t, s.maybeModifyListenerAndRoutes([]*listenerv3.Listener{listener}, routes))
+		require.NoError(t, patchInferenceObjectiveListeners([]*listenerv3.Listener{listener}, routes))
+		hcm.Reset()
+		require.NoError(t, listener.DefaultFilterChain.Filters[0].GetTypedConfig().UnmarshalTo(hcm))
+		require.Len(t, hcm.HttpFilters, 5, "one auth, one mutation, two distinct EPPs, one router")
+		require.Equal(t, "envoy.filters.http.ext_authz", hcm.HttpFilters[0].Name)
+		require.Equal(t, inferenceObjectiveFilter, hcm.HttpFilters[1].Name)
+		require.Equal(t, "envoy.filters.http.router", hcm.HttpFilters[4].Name)
+		for _, filter := range hcm.HttpFilters[2:4] {
+			epp := &extprocv3.ExternalProcessor{}
+			require.NoError(t, filter.GetTypedConfig().UnmarshalTo(epp))
+			require.False(t, epp.FailureModeAllow)
+			require.False(t, epp.AllowModeOverride)
+			require.Equal(t, extprocv3.ProcessingMode_FULL_DUPLEX_STREAMED, epp.ProcessingMode.RequestBodyMode)
+			require.Equal(t, extprocv3.ProcessingMode_FULL_DUPLEX_STREAMED, epp.ProcessingMode.ResponseBodyMode)
+			require.Equal(t, 900*time.Second, epp.MessageTimeout.AsDuration())
+			require.Equal(t, extprocv3.ExternalProcessor_RETAIN, epp.RouteCacheAction)
+		}
+		for _, route := range priorityRoutes {
+			require.Equal(t, "/v1/chat/completions", route.GetRoute().PrefixRewrite)
+			require.Equal(t, uint32(7), route.GetRoute().RequestMirrorPolicies[0].RuntimeFraction.DefaultValue.Numerator)
+			require.Equal(t, "candidate-runtime-service", route.GetRoute().RequestMirrorPolicies[0].Cluster)
+			for selected, backend := range route.GetRoute().GetWeightedClusters().Clusters {
+				require.Equal(t, clusters[selected].Name, backend.Name)
+				for other, pool := range pools {
+					filter := httpFilterNameForInferencePool(pool)
+					config := route.TypedPerFilterConfig[filter]
+					if override := backend.TypedPerFilterConfig[filter]; override != nil {
+						config = override
+					}
+					effective := &extprocv3.ExtProcPerRoute{}
+					require.NoError(t, config.UnmarshalTo(effective))
+					require.Equal(t, selected != other, effective.GetDisabled(), "only selected pool admits request")
+				}
+				mutation := &headermutationv3.HeaderMutationPerRoute{}
+				require.NoError(t, backend.TypedPerFilterConfig[inferenceObjectiveFilter].UnmarshalTo(mutation))
+				require.Equal(t, pools[selected].Name+"-"+route.Name, mutation.Mutations.RequestMutations[0].GetAppend().Header.Value)
+				require.Equal(t, corev3.HeaderValueOption_OVERWRITE_IF_EXISTS_OR_ADD, mutation.Mutations.RequestMutations[0].GetAppend().AppendAction)
+			}
+			require.Equal(t, uint32(95), route.GetRoute().GetWeightedClusters().Clusters[0].Weight.Value)
+			require.Equal(t, uint32(5), route.GetRoute().GetWeightedClusters().Clusters[1].Weight.Value)
+		}
+		for _, pool := range pools {
+			config := &extprocv3.ExtProcPerRoute{}
+			require.NoError(t, unrelated.TypedPerFilterConfig[httpFilterNameForInferencePool(pool)].UnmarshalTo(config))
+			require.True(t, config.GetDisabled())
+		}
+	}
+}
