+// own extension metadata is the authoritative pool identity; extension resource
+// order and Envoy's cluster naming conventions are deliberately irrelevant.
+func prepareWeightedInferencePoolRoutes(clusters []*clusterv3.Cluster, configs []*routev3.RouteConfiguration) error {
+	poolsByCluster := make(map[string]*gwaiev1.InferencePool)
+	for _, cluster := range clusters {
+		if pool := getInferencePoolByMetadata(cluster.Metadata); pool != nil {
+			poolsByCluster[cluster.Name] = pool
+		}
+	}
+	for _, config := range configs {
+		for _, host := range config.VirtualHosts {
+			for _, route := range host.Routes {
+				action := route.GetRoute()
+				if action == nil || action.GetWeightedClusters() == nil {
+					continue
+				}
+				var poolValues []*structpb.Value
+				for _, backend := range action.GetWeightedClusters().Clusters {
+					pool := poolsByCluster[backend.Name]
+					if pool == nil {
+						continue
+					}
+					if backend.TypedPerFilterConfig == nil {
+						backend.TypedPerFilterConfig = make(map[string]*anypb.Any)
+					}
+					// The enclosing route disables every EPP; the chosen weighted
+					// cluster overrides only its own EPP. Envoy chooses the cluster
+					// while resolving the route, before decoder filter execution.
+					enable, err := toAny(&extprocv3.ExtProcPerRoute{
+						Override: &extprocv3.ExtProcPerRoute_Overrides{Overrides: &extprocv3.ExtProcOverrides{}},
+					})
+					if err != nil {
+						return err
+					}
+					backend.TypedPerFilterConfig[httpFilterNameForInferencePool(pool)] = enable
+					if err := configureInferenceObjective(backend); err != nil {
+						return fmt.Errorf("route %s backend %s: %w", route.Name, backend.Name, err)
+					}
+					meta := &corev3.Metadata{}
+					buildEPPMetadata(meta, pool)
+					poolValues = append(poolValues, meta.FilterMetadata[internalapi.InternalEndpointMetadataNamespace].Fields[internalMetadataInferencePoolKey])
+				}
+				if len(poolValues) == 0 {
+					continue
+				}
+				action.HostRewriteSpecifier = &routev3.RouteAction_AutoHostRewrite{AutoHostRewrite: wrapperspb.Bool(false)}
+				if route.Metadata == nil {
+					route.Metadata = &corev3.Metadata{}
+				}
+				if route.Metadata.FilterMetadata == nil {
+					route.Metadata.FilterMetadata = make(map[string]*structpb.Struct)
+				}
+				meta := route.Metadata.FilterMetadata[internalapi.InternalEndpointMetadataNamespace]
+				if meta == nil {
+					meta = &structpb.Struct{Fields: make(map[string]*structpb.Value)}
+					route.Metadata.FilterMetadata[internalapi.InternalEndpointMetadataNamespace] = meta
+				}
+				if meta.Fields == nil {
+					meta.Fields = make(map[string]*structpb.Value)
+				}
+				// Do not leave the single-pool default enabled for weighted routes.
+				delete(meta.Fields, internalMetadataInferencePoolKey)
+				meta.Fields[weightedInferencePoolsKey] = structpb.NewListValue(&structpb.ListValue{Values: poolValues})
+			}
+		}
+	}
+	return nil
+}
+
+func inferencePoolsForRoute(route *routev3.Route) []*gwaiev1.InferencePool {
+	if route.Metadata != nil {
+		meta := route.Metadata.FilterMetadata[internalapi.InternalEndpointMetadataNamespace]
+		if meta != nil {
+			if values := meta.Fields[weightedInferencePoolsKey].GetListValue(); values != nil {
+				var pools []*gwaiev1.InferencePool
+				for _, value := range values.Values {
+					poolMeta := &corev3.Metadata{FilterMetadata: map[string]*structpb.Struct{
+						internalapi.InternalEndpointMetadataNamespace: {Fields: map[string]*structpb.Value{internalMetadataInferencePoolKey: value}},
+					}}
+					if pool := getInferencePoolByMetadata(poolMeta); pool != nil {
+						pools = append(pools, pool)
+					}
+				}
+				return pools
+			}
+		}
+	}
+	if pool := getInferencePoolByMetadata(route.Metadata); pool != nil {
+		return []*gwaiev1.InferencePool{pool}
+	}
+	return nil
+}
+
+// Envoy normally applies backend request_headers_to_add in the router filter,
+// after EPP. Copy only the literal objective overwrite into a decoder mutation
+// filter. Retaining the router mutation preserves the upstream header contract
+// and is idempotent because append/add semantics are rejected.
+func configureInferenceObjective(backend *routev3.WeightedCluster_ClusterWeight) error {
+	var objective *corev3.HeaderValueOption
+	for _, header := range backend.RequestHeadersToAdd {
+		if !strings.EqualFold(header.GetHeader().GetKey(), inferenceObjectiveHeader) {
+			continue
+		}
+		if objective != nil || header.AppendAction != corev3.HeaderValueOption_OVERWRITE_IF_EXISTS_OR_ADD ||
+			header.GetAppend().GetValue() || header.GetHeader().GetValue() == "" || strings.Contains(header.GetHeader().GetValue(), "%") {
+			return fmt.Errorf("inference objective must be one literal overwrite")
+		}
+		objective = header
+	}
+	if objective == nil {
+		return nil // Generic InferencePools need not use llm-d objectives.
+	}
+	config, err := toAny(&headermutationv3.HeaderMutationPerRoute{
+		Mutations: &headermutationv3.Mutations{RequestMutations: []*mutationrulesv3.HeaderMutation{{
+			Action: &mutationrulesv3.HeaderMutation_Append{Append: objective},
+		}}},
+	})
+	if err != nil {
+		return err
+	}
+	backend.TypedPerFilterConfig[inferenceObjectiveFilter] = config
+	return nil
+}
+
+func patchInferenceObjectiveListeners(listeners []*listenerv3.Listener, configs []*routev3.RouteConfiguration) error {
+	needsFilter := make(map[string]bool)
+	for _, config := range configs {
+		for _, host := range config.VirtualHosts {
+			for _, route := range host.Routes {
+				if route.GetRoute().GetWeightedClusters() == nil {
+					continue
+				}
+				for _, backend := range route.GetRoute().GetWeightedClusters().Clusters {
+					needsFilter[config.Name] = needsFilter[config.Name] || backend.TypedPerFilterConfig[inferenceObjectiveFilter] != nil
+				}
+			}
+		}
+	}
+	for _, listener := range listeners {
+		needed := false
+		for _, config := range findListenerRouteConfigs(listener) {
+			needed = needed || needsFilter[config]
+		}
+		if !needed {
+			continue
+		}
+		chains := append([]*listenerv3.FilterChain{}, listener.FilterChains...)
+		if listener.DefaultFilterChain != nil {
+			chains = append(chains, listener.DefaultFilterChain)
+		}
+		for _, chain := range chains {
+			hcm, index, err := findHCM(chain)
+			if err != nil {
+				return err
+			}
+			if err = insertInferenceObjectiveMutation(hcm); err != nil {
+				return err
+			}
+			config, err := toAny(hcm)
+			if err != nil {
+				return err
+			}
+			chain.Filters[index].ConfigType = &listenerv3.Filter_TypedConfig{TypedConfig: config}
+		}
+	}
+	return nil
+}
+
+func insertInferenceObjectiveMutation(hcm *hcmv3.HttpConnectionManager) error {
+	for _, filter := range hcm.HttpFilters {
+		if filter.Name == inferenceObjectiveFilter {
+			return nil
+		}
+	}
+	config, err := toAny(&headermutationv3.HeaderMutation{})
+	if err != nil {
+		return err
+	}
+	for index, filter := range hcm.HttpFilters {
+		if strings.HasPrefix(filter.Name, "envoy.filters.http.ext_proc/endpointpicker/") {
+			mutation := &hcmv3.HttpFilter{Name: inferenceObjectiveFilter, ConfigType: &hcmv3.HttpFilter_TypedConfig{TypedConfig: config}}
+			hcm.HttpFilters = append(hcm.HttpFilters[:index], append([]*hcmv3.HttpFilter{mutation}, hcm.HttpFilters[index:]...)...)
+			return nil
+		}
+	}
+	return fmt.Errorf("inference objective filter requires an endpoint-picker filter")
+}
