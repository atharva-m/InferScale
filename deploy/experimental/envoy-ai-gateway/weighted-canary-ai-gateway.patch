+func TestInferenceObjectiveRejectsAppendAndDynamicValues(t *testing.T) {
+	for _, header := range []*corev3.HeaderValueOption{
+		{Header: &corev3.HeaderValue{Key: inferenceObjectiveHeader, Value: "candidate"}},
+		{Header: &corev3.HeaderValue{Key: inferenceObjectiveHeader, Value: "%REQ(spoof)%"}, AppendAction: corev3.HeaderValueOption_OVERWRITE_IF_EXISTS_OR_ADD},
+	} {
+		backend := &routev3.WeightedCluster_ClusterWeight{TypedPerFilterConfig: make(map[string]*anypb.Any), RequestHeadersToAdd: []*corev3.HeaderValueOption{header}}
+		require.Error(t, configureInferenceObjective(backend))
+	}
+	backend := &routev3.WeightedCluster_ClusterWeight{RequestHeadersToAdd: []*corev3.HeaderValueOption{{Header: &corev3.HeaderValue{Key: "unrelated", Value: "preserve"}}}}
+	original := proto.Clone(backend)
+	require.NoError(t, configureInferenceObjective(backend))
+	require.True(t, proto.Equal(original, backend))
