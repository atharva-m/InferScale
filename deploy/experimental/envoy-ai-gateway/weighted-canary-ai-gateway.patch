+func Test_parseAndValidateFlags_secretNamespaces(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		args     []string
+		expected []string
+		expErr   string
+	}{
+		{name: "omitted inherits watch namespaces"},
+		{name: "explicit empty is rejected", args: []string{"--secretNamespaces="}, expErr: "secretNamespaces must contain at least one namespace when specified"},
+		{
+			name:     "single namespace",
+			args:     []string{"--secretNamespaces=envoy-ai-gateway-system"},
+			expected: []string{"envoy-ai-gateway-system"},
+		},
+		{
+			name:     "candidate namespaces",
+			args:     []string{"--watchNamespaces=", "--secretNamespaces=envoy-ai-gateway-system,inferscale-gateway"},
+			expected: []string{"envoy-ai-gateway-system", "inferscale-gateway"},
+		},
+		{
+			name:     "whitespace and empty entries",
+			args:     []string{"--secretNamespaces= envoy-ai-gateway-system, ,inferscale-gateway, "},
+			expected: []string{"envoy-ai-gateway-system", "inferscale-gateway"},
+		},
+		{
+			name:   "commas cannot broaden access",
+			args:   []string{"--secretNamespaces=,,,"},
+			expErr: "secretNamespaces must contain at least one namespace when specified",
+		},
+		{
+			name:   "whitespace cannot broaden access",
+			args:   []string{"--secretNamespaces=  "},
+			expErr: "secretNamespaces must contain at least one namespace when specified",
+		},
+		{
+			name:   "wildcard rejected",
+			args:   []string{"--secretNamespaces=*"},
+			expErr: `invalid secret namespace "*"`,
+		},
+		{
+			name:   "invalid namespace rejected",
+			args:   []string{"--secretNamespaces=inferscale-gateway,Invalid_Namespace"},
+			expErr: `invalid secret namespace "Invalid_Namespace"`,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f, err := parseAndValidateFlags(tc.args)
+			if tc.expErr != "" {
+				require.ErrorContains(t, err, tc.expErr)
+				require.Nil(t, f)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.expected, f.secretNamespaces)
+		})
+	}
+}
