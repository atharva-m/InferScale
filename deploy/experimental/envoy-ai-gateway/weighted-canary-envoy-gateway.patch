@@ -0,0 +1,34 @@
+// Copyright Envoy Gateway Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package translator
+
+import (
+	"github.com/envoyproxy/gateway/internal/ir"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+)
+
+// extensionResourcesForSetting keeps route-level extension filters but supplies
+// only this cluster's custom backend resource. Sending every backend to each
+// cluster hook makes the selected InferencePool ambiguous during a canary.
+func extensionResourcesForSetting(setting *ir.DestinationSetting, settings []*ir.DestinationSetting, resources []*unstructured.Unstructured) []*unstructured.Unstructured {
+	var selected []*unstructured.Unstructured
+	for _, resource := range resources {
+		isBackend := false
+		matchesSetting := false
+		for _, candidate := range settings {
+			if !candidate.IsCustomBackend || candidate.Metadata == nil {
+				continue
+			}
+			metadata := candidate.Metadata
+			if resource.GetKind() == metadata.Kind && resource.GetNamespace() == metadata.Namespace && resource.GetName() == metadata.Name {
+				isBackend = true
+				matchesSetting = matchesSetting || candidate == setting
+			}
+		}
+		if !isBackend || matchesSetting {
+			selected = append(selected, resource)
+		}
+	}
+	return selected
+}
