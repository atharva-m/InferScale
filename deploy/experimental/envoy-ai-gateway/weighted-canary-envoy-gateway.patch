+)
+
+func TestInferenceBackendFiltersAndMetadata(t *testing.T) {
+	input, err := os.ReadFile("testdata/extensions/httproute-with-custom-backend-multiple.in.yaml")
+	require.NoError(t, err)
+	resources := &resource.Resources{}
+	mustUnmarshal(t, input, resources)
+	base, err := os.ReadFile("testdata/base/base.yaml")
+	require.NoError(t, err)
+	baseResources := &resource.Resources{}
+	mustUnmarshal(t, base, baseResources)
+	resources.Secrets = append(resources.Secrets, baseResources.Secrets...)
+	resources.Namespaces = append(resources.Namespaces,
+		&corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: "default"}},
+		&corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: "envoy-gateway"}},
+	)
+	resources.HTTPRoutes[0].Spec.Rules = resources.HTTPRoutes[0].Spec.Rules[:1]
+	for i := range resources.HTTPRoutes[0].Spec.Rules[0].BackendRefs {
+		backend := &resources.HTTPRoutes[0].Spec.Rules[0].BackendRefs[i]
+		backend.Filters = []gwapiv1.HTTPRouteFilter{{
+			Type: gwapiv1.HTTPRouteFilterRequestHeaderModifier,
+			RequestHeaderModifier: &gwapiv1.HTTPHeaderFilter{
+				Set: []gwapiv1.HTTPHeader{{Name: "x-llm-d-inference-objective", Value: string(backend.Name) + "-interactive"}},
+			},
+		}}
+	}
+	translator := &Translator{
+		GatewayControllerName: egv1a1.GatewayControllerName,
+		GatewayClassName:      "envoy-gateway-class",
+		ControllerNamespace:   "envoy-gateway-system",
+		ExtensionGroupKinds:   []schema.GroupKind{{Group: "storage.example.io", Kind: "S3Backend"}},
+		Logger:                logging.DefaultLogger(io.Discard, egv1a1.LogLevelInfo),
+	}
+	result, err := translator.Translate(resources)
+	require.NoError(t, err)
+	checked := false
+	for _, xds := range result.XdsIR {
+		for _, listener := range xds.HTTP {
+			for _, route := range listener.Routes {
+				if route.Destination == nil {
+					continue
+				}
+				checked = true
+				require.Len(t, route.ExtensionRefs, 2)
+				require.Len(t, route.Destination.Settings, 2)
+				require.True(t, route.NeedsClusterPerSetting())
+				for i, setting := range route.Destination.Settings {
+					backend := resources.HTTPRoutes[0].Spec.Rules[0].BackendRefs[i]
+					require.True(t, setting.IsCustomBackend)
+					require.Equal(t, string(backend.Name), setting.Metadata.Name)
+					require.Equal(t, "default", setting.Metadata.Namespace)
+					require.Equal(t, "S3Backend", setting.Metadata.Kind)
+					require.NotNil(t, setting.Filters, "custom backend filters must survive translation")
+					require.Len(t, setting.Filters.AddRequestHeaders, 1)
+					require.Equal(t, []string{string(backend.Name) + "-interactive"}, setting.Filters.AddRequestHeaders[0].Value)
+					require.False(t, setting.Filters.AddRequestHeaders[0].Append)
+				}
+			}
+		}
+	}
+	require.True(t, checked, "expected a translated route")
+}
