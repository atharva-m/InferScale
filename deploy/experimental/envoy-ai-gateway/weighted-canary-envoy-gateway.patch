+// Copyright Envoy Gateway Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package translator
+
+import (
+	"testing"
+
+	"github.com/envoyproxy/gateway/internal/ir"
+	corev3 "github.com/envoyproxy/go-control-plane/envoy/config/core/v3"
+	"github.com/stretchr/testify/require"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+)
+
+func TestInferenceClusterGetsOnlyItsBackendResource(t *testing.T) {
+	resource := func(kind, namespace, name string) *unstructured.Unstructured {
+		obj := &unstructured.Unstructured{}
+		obj.SetKind(kind)
+		obj.SetNamespace(namespace)
+		obj.SetName(name)
+		return obj
+	}
+	stable := &ir.DestinationSetting{IsCustomBackend: true, Metadata: &ir.ResourceMetadata{Kind: "InferencePool", Namespace: "tenant", Name: "stable"}}
+	candidate := &ir.DestinationSetting{IsCustomBackend: true, Metadata: &ir.ResourceMetadata{Kind: "InferencePool", Namespace: "tenant", Name: "candidate"}}
+	service := &ir.DestinationSetting{Metadata: &ir.ResourceMetadata{Kind: "Service", Namespace: "tenant", Name: "mirror"}}
+	settings := []*ir.DestinationSetting{stable, candidate, service}
+	stableResource := resource("InferencePool", "tenant", "stable")
+	candidateResource := resource("InferencePool", "tenant", "candidate")
+	routeFilter := resource("SomeFilter", "tenant", "policy")
+	resources := []*unstructured.Unstructured{candidateResource, routeFilter, stableResource}
+	require.Equal(t, []*unstructured.Unstructured{routeFilter, stableResource}, extensionResourcesForSetting(stable, settings, resources))
+	require.Equal(t, []*unstructured.Unstructured{candidateResource, routeFilter}, extensionResourcesForSetting(candidate, settings, resources))
+	require.Equal(t, []*unstructured.Unstructured{routeFilter}, extensionResourcesForSetting(service, settings, resources))
+	require.Len(t, resources, 3, "must not mutate shared route extension resources")
+	settings = []*ir.DestinationSetting{stable, candidate}
+	destination := &ir.RouteDestination{Settings: settings}
+	require.True(t, destination.NeedsClusterPerSetting(), "pool identity survives even without backend filters")
+}
+
+func TestInferenceWeightedClustersKeepCustomBackendsAndHeaders(t *testing.T) {
+	settings := []*ir.DestinationSetting{}
+	for _, backend := range []struct {
+		name   string
+		weight uint32
+	}{{"stable", 95}, {"candidate", 5}} {
+		settings = append(settings, &ir.DestinationSetting{
+			Name: backend.name, Weight: new(backend.weight), IsCustomBackend: true,
+			Filters: &ir.DestinationFilters{AddRequestHeaders: []ir.AddHeader{{Name: "x-llm-d-inference-objective", Value: []string{backend.name + "-interactive"}}}},
+		})
+	}
+	destination := &ir.RouteDestination{Name: "deployment", Settings: settings}
+	weighted := buildXdsWeightedRouteAction(destination.ToBackendWeights(), settings).GetWeightedClusters()
+	require.Len(t, weighted.Clusters, 2, "custom backends have no static endpoints but are routable")
+	for index, cluster := range weighted.Clusters {
+		require.Equal(t, settings[index].Name, cluster.Name)
+		require.Equal(t, *settings[index].Weight, cluster.Weight.Value)
+		require.Len(t, cluster.RequestHeadersToAdd, 1)
+		require.Equal(t, settings[index].Name+"-interactive", cluster.RequestHeadersToAdd[0].Header.Value)
+		require.Equal(t, corev3.HeaderValueOption_OVERWRITE_IF_EXISTS_OR_ADD, cluster.RequestHeadersToAdd[0].AppendAction)
+	}
+}
