 func (r *RouteDestination) NeedsClusterPerSetting() bool {
+	// A custom backend may carry its own external processor and endpoint
+	// selection contract. Combining distinct custom backends in one cluster
+	// loses that identity before the extension translation hooks run.
+	if len(r.Settings) > 1 {
+		for _, setting := range r.Settings {
+			if setting.IsCustomBackend {
+				return true
+			}
+		}
+	}
 	return r.HasMixedEndpoints() ||
 		r.HasFiltersInSettings() ||
 		(len(r.Settings) > 1 && r.HasPreferLocalZone()) ||
