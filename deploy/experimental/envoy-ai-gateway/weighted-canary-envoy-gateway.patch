+)
+
+type discoveryFixtureTransport struct{}
+
+func (discoveryFixtureTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	status, body := http.StatusOK, ""
+	switch request.URL.String() {
+	case "https://accounts.google.com/.well-known/openid-configuration":
+		body = `{"authorization_endpoint":"https://accounts.google.com/o/oauth2/v2/auth","token_endpoint":"https://oauth2.googleapis.com/token"}`
+	case "https://gateway.envoyproxy.io/.well-known/openid-configuration":
+		status = http.StatusNotFound
+	default:
+		return nil, fmt.Errorf("unexpected network request in offline translation fixture: %s", request.URL)
+	}
+	return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: request}, nil
+}
+
+// TestTranslate's upstream golden cases depend on two public discovery URLs.
+// Keep their success/404 inputs deterministic without changing production OIDC
+// behavior or skipping any case. Dedicated discovery tests use local servers.
+func useOfflineDiscoveryFixtures(t *testing.T) {
+	t.Helper()
+	previous := http.DefaultTransport
+	http.DefaultTransport = discoveryFixtureTransport{}
+	t.Cleanup(func() { http.DefaultTransport = previous })
+}
