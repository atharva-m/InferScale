# syntax=docker/dockerfile:1.9
# Context: InferScale repository. Named context upstream contains the archive
# named llm-d-router-v0.9.0.tar.gz. See README.md for the capped builder command.
ARG GO_IMAGE=golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

FROM ${GO_IMAGE} AS build
ENV GOMAXPROCS=2 GOMEMLIMIT=1GiB CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS="-p=2 -mod=readonly"
RUN apk add --no-cache patch gcc musl-dev
WORKDIR /inputs
COPY --from=upstream /llm-d-router-v0.9.0.tar.gz ./
COPY deploy/experimental/llm-d/round-robin-picker.patch deploy/experimental/llm-d/SHA256SUMS deploy/experimental/llm-d/patched-files.sha256 ./
RUN --network=none sha256sum -c SHA256SUMS && \
    mkdir /src && tar -xzf llm-d-router-v0.9.0.tar.gz --strip-components=1 -C /src && \
    cd /src && patch --batch --fuzz=0 -p1 < /inputs/round-robin-picker.patch && \
    sha256sum -c /inputs/patched-files.sha256
WORKDIR /src
RUN \
    go mod download && go mod verify && sha256sum -c /inputs/patched-files.sha256
RUN --network=none \
    --mount=type=cache,target=/root/.cache/go-build \
    test -z "$(gofmt -l pkg/epp/framework/plugins/scheduling/picker/roundrobin cmd/epp/runner/runner.go pkg/common/observability/tracing/telemetry.go pkg/common/observability/tracing/telemetry_test.go pkg/epp/handlers/request.go pkg/epp/handlers/request_test.go pkg/epp/util/request/headers.go pkg/epp/util/request/headers_test.go)" && \
    CGO_ENABLED=1 go test -race -p=1 -count=1 -timeout=5m ./pkg/epp/framework/plugins/scheduling/picker/roundrobin ./pkg/common/observability/tracing ./pkg/epp/handlers ./pkg/epp/util/request
RUN --network=none \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -buildvcs=false \
    -ldflags='-s -w -X github.com/llm-d/llm-d-router/version.BuildRef=v0.9.0-inferscale-round-robin' \
    -o /out/epp ./cmd/epp && sha256sum -c /inputs/patched-files.sha256

FROM ${RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="InferScale local llm-d EPP round-robin candidate" \
      org.opencontainers.image.version="v0.9.0-inferscale-round-robin" \
      io.inferscale.validation="pending image build and live qualification"
COPY --from=build /out/epp /app/epp
USER 65532:65532
EXPOSE 9002 9003 9090 5557
ENTRYPOINT ["/app/epp"]
