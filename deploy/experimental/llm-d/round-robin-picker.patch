+package roundrobin
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+
+	k8stypes "k8s.io/apimachinery/pkg/types"
+
+	fwkdl "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/datalayer"
+	fwksched "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/scheduling"
+)
+
+func endpoint(name string, score float64) *fwksched.ScoredEndpoint {
+	return &fwksched.ScoredEndpoint{
+		Endpoint: fwksched.NewEndpoint(&fwkdl.EndpointMetadata{
+			NamespacedName: k8stypes.NamespacedName{Namespace: "tenant-a", Name: name},
+			Address:        "10.0.0.1", Port: "8000",
+		}, nil, nil),
+		Score: score,
+	}
+}
+
+func names(result *fwksched.ProfileRunResult) []string {
+	output := make([]string, len(result.TargetEndpoints))
+	for i, endpoint := range result.TargetEndpoints {
+		output[i] = endpoint.GetMetadata().NamespacedName.Name
+	}
+	return output
+}
+
+func TestPickCyclesDespiteCandidateReorderingAndScores(t *testing.T) {
+	a, b, c := endpoint("a", 0), endpoint("b", 100), endpoint("c", -5)
+	inputs := [][]*fwksched.ScoredEndpoint{{c, a, b}, {b, c, a}, {a, b, c}}
+	picker := NewRoundRobinPicker(1)
+	for index, expected := range []string{"a", "b", "c", "a", "b", "c"} {
+		input := inputs[index%len(inputs)]
+		original := slices.Clone(input)
+		if got := names(picker.Pick(context.Background(), input)); !reflect.DeepEqual(got, []string{expected}) {
+			t.Fatalf("pick %d = %v, want %s", index, got, expected)
+		}
+		if !slices.Equal(input, original) {
+			t.Fatal("picker mutated scheduler input")
+		}
+	}
+}
+
+func TestPickSurvivesCandidateChurnAndEmptyIntervals(t *testing.T) {
+	a, b, c, d := endpoint("a", 0), endpoint("b", 0), endpoint("c", 0), endpoint("d", 0)
+	picker := NewRoundRobinPicker(1)
+	steps := []struct {
+		input []*fwksched.ScoredEndpoint
+		want  []string
+	}{
+		{nil, []string{}},
+		{[]*fwksched.ScoredEndpoint{c, a}, []string{"a"}},
+		{[]*fwksched.ScoredEndpoint{c, b, a}, []string{"b"}}, // inserted successor
+		{[]*fwksched.ScoredEndpoint{a, c}, []string{"c"}},    // removed cursor endpoint
+		{nil, []string{}},
+		{[]*fwksched.ScoredEndpoint{d}, []string{"d"}},
+		{[]*fwksched.ScoredEndpoint{c, a}, []string{"a"}}, // wrap after replacement
+		{[]*fwksched.ScoredEndpoint{a}, []string{"a"}},
+		{[]*fwksched.ScoredEndpoint{b, a}, []string{"b"}},
+	}
+	for index, step := range steps {
+		if got := names(picker.Pick(context.Background(), step.input)); !reflect.DeepEqual(got, step.want) {
+			t.Fatalf("step %d = %v, want %v", index, got, step.want)
+		}
+	}
+}
+
+func TestPickBatchAdvancesAcrossWrapWithoutDuplicates(t *testing.T) {
+	a, b, c := endpoint("a", 0), endpoint("b", 0), endpoint("c", 0)
+	picker := NewRoundRobinPicker(2)
+	for index, expected := range [][]string{{"a", "b"}, {"c", "a"}, {"b", "c"}} {
+		if got := names(picker.Pick(context.Background(), []*fwksched.ScoredEndpoint{c, a, b, a})); !reflect.DeepEqual(got, expected) {
+			t.Fatalf("pick %d = %v, want %v", index, got, expected)
+		}
+	}
+	if got := names(NewRoundRobinPicker(10).Pick(context.Background(), []*fwksched.ScoredEndpoint{c, a, b})); !reflect.DeepEqual(got, []string{"a", "b", "c"}) {
+		t.Fatalf("oversized batch = %v", got)
+	}
+}
+
+func TestPickDistinguishesNamespaceAddressPortAndRank(t *testing.T) {
+	base := endpoint("pod", 0)
+	inputs := []*fwksched.ScoredEndpoint{base}
+	for _, change := range []func(*fwkdl.EndpointMetadata){
+		func(metadata *fwkdl.EndpointMetadata) { metadata.NamespacedName.Namespace = "tenant-b" },
+		func(metadata *fwkdl.EndpointMetadata) { metadata.Address = "10.0.0.2" },
+		func(metadata *fwkdl.EndpointMetadata) { metadata.Port = "8001" },
+		func(metadata *fwkdl.EndpointMetadata) { metadata.RankIndex = 1 },
+	} {
+		metadata := base.GetMetadata().Clone()
+		change(metadata)
+		inputs = append(inputs, &fwksched.ScoredEndpoint{Endpoint: fwksched.NewEndpoint(metadata, nil, nil)})
+	}
+	picker := NewRoundRobinPicker(1)
+	seen := map[fwksched.Endpoint]bool{}
+	for range len(inputs) {
+		selected := picker.Pick(context.Background(), inputs).TargetEndpoints[0]
+		if seen[selected] {
+			t.Fatal("distinct endpoint identity was skipped")
+		}
+		seen[selected] = true
+	}
+	if got := picker.Pick(context.Background(), inputs).TargetEndpoints[0]; got != base {
+		t.Fatalf("cycle did not wrap to first endpoint: %v", got)
+	}
+}
+
+func TestPickConcurrentCallsAreExactlyBalancedAndDoNotMutateInput(t *testing.T) {
+	input := []*fwksched.ScoredEndpoint{endpoint("c", 0), endpoint("a", 0), endpoint("b", 0)}
+	original := slices.Clone(input)
+	picker := NewRoundRobinPicker(1)
+	const workers, calls = 48, 100
+	results := make(chan string, workers*calls)
+	var group sync.WaitGroup
+	for range workers {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			for range calls {
+				results <- names(picker.Pick(context.Background(), input))[0]
+			}
+		}()
+	}
+	group.Wait()
+	close(results)
+	counts := map[string]int{}
+	for result := range results {
+		counts[result]++
+	}
+	for _, name := range []string{"a", "b", "c"} {
+		if counts[name] != workers*calls/len(input) {
+			t.Fatalf("counts = %v, want exactly %d per endpoint", counts, workers*calls/len(input))
+		}
+	}
+	if !slices.Equal(input, original) {
+		t.Fatal("concurrent calls mutated scheduler input")
+	}
+}
+
+func TestFactoryDefaultsNamingAndInvalidParameters(t *testing.T) {
+	for _, parameters := range []string{"", "{}", `{"maxNumOfEndpoints":0}`, `{"maxNumOfEndpoints":-1}`} {
+		var decoder *json.Decoder
+		if parameters != "" {
+			decoder = json.NewDecoder(strings.NewReader(parameters))
+		}
+		plugin, err := RoundRobinPickerFactory("custom", decoder, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if plugin.TypedName().Type != RoundRobinPickerType || plugin.TypedName().Name != "custom" {
+			t.Fatalf("plugin identity = %#v", plugin.TypedName())
+		}
+		picker := plugin.(*RoundRobinPicker)
+		if got := picker.Pick(context.Background(), []*fwksched.ScoredEndpoint{nil, {}, endpoint("b", 0), endpoint("a", 0)}); len(got.TargetEndpoints) != 1 {
+			t.Fatalf("default count = %d", len(got.TargetEndpoints))
+		}
+	}
+	if _, err := RoundRobinPickerFactory("invalid", json.NewDecoder(strings.NewReader(`{"maxNumOfEndpoints":"two"}`)), nil); err == nil {
+		t.Fatal("factory accepted invalid parameter type")
+	}
+}
