+func TestInitTracingExportsConfiguredServiceIdentity(t *testing.T) {
+	for _, test := range []struct {
+		name  string
+		value string
+		unset bool
+		want  string
+	}{
+		{name: "configured", value: "inferscale-epp", want: "inferscale-epp"},
+		{name: "unset defaults", unset: true, want: "llm-d-epp"},
+		{name: "empty defaults", want: "llm-d-epp"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Setenv("OTEL_SERVICE_NAME", test.value)
+			if test.unset {
+				if err := os.Unsetenv("OTEL_SERVICE_NAME"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			t.Setenv("OTEL_EXPORTER_OTLP_ENDPOINT", "http://localhost:4317")
+			t.Setenv("OTEL_TRACES_EXPORTER", "console")
+			t.Setenv("OTEL_TRACES_SAMPLER", "parentbased_traceidratio")
+			t.Setenv("OTEL_TRACES_SAMPLER_ARG", "1")
+			originalProvider := otel.GetTracerProvider()
+			originalPropagator := otel.GetTextMapPropagator()
+			originalErrorHandler := otel.GetErrorHandler()
+			t.Cleanup(func() {
+				otel.SetTracerProvider(originalProvider)
+				otel.SetTextMapPropagator(originalPropagator)
+				otel.SetErrorHandler(originalErrorHandler)
+			})
+			shutdown, err := InitTracing(context.Background(), logr.Discard(), "llm-d-epp")
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if err := shutdown(context.Background()); err != nil {
+					t.Error(err)
+				}
+			})
+			carrier := propagation.MapCarrier{
+				"traceparent": "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01",
+				"tracestate":  "vendor=retained",
+				"baggage":     "secret=client-value",
+			}
+			ctx := otel.GetTextMapPropagator().Extract(context.Background(), carrier)
+			parent := trace.SpanContextFromContext(ctx)
+			if parent.TraceID().String() != "0af7651916cd43dd8448eb211c80319c" ||
+				parent.SpanID().String() != "b7ad6b7169203331" || !parent.IsSampled() || !parent.IsRemote() ||
+				parent.TraceState().String() != "vendor=retained" {
+				t.Fatal("W3C caller context was not preserved")
+			}
+			if baggage.FromContext(ctx).Len() != 0 {
+				t.Fatal("client baggage crossed the trace boundary")
+			}
+			forwarded := propagation.MapCarrier{}
+			otel.GetTextMapPropagator().Inject(ctx, forwarded)
+			if len(forwarded) != 2 || forwarded["traceparent"] != carrier["traceparent"] || forwarded["tracestate"] != carrier["tracestate"] {
+				t.Fatal("outbound propagation must contain only the canonical W3C context")
+			}
+			recorder := tracetest.NewSpanRecorder()
+			otel.GetTracerProvider().(*sdktrace.TracerProvider).RegisterSpanProcessor(recorder)
+			_, span := Tracer().Start(context.Background(), "service-identity-test")
+			span.End()
+			ended := recorder.Ended()
+			if len(ended) != 1 {
+				t.Fatalf("recorded %d spans, want one", len(ended))
+			}
+			attributes := ended[0].Resource().Set()
+			name, ok := attributes.Value(semconv.ServiceNameKey)
+			if !ok || name.AsString() != test.want {
+				t.Fatalf("service.name = %v, want %s", name, test.want)
+			}
+			buildVersion, ok := attributes.Value(semconv.ServiceVersionKey)
+			if !ok || buildVersion.AsString() != version.BuildRef {
+				t.Fatalf("service.version = %v, want %s", buildVersion, version.BuildRef)
+			}
+		})
+	}
+}
 
