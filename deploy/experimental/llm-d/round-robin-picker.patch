+func TestGenerateRequestHeaderResponse_CanonicalTraceContext(t *testing.T) {
+	previous := otel.GetTextMapPropagator()
+	otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(propagation.TraceContext{}, propagation.Baggage{}))
+	t.Cleanup(func() { otel.SetTextMapPropagator(previous) })
+
+	traceID, err := trace.TraceIDFromHex("0af7651916cd43dd8448eb211c80319c")
+	assert.NoError(t, err)
+	spanID, err := trace.SpanIDFromHex("b7ad6b7169203331")
+	assert.NoError(t, err)
+	state, err := trace.ParseTraceState("vendor=canonical")
+	assert.NoError(t, err)
+	member, err := baggage.NewMember("secret", "client-value")
+	assert.NoError(t, err)
+	bag, err := baggage.New(member)
+	assert.NoError(t, err)
+
+	for _, test := range []struct {
+		name  string
+		valid bool
+		state trace.TraceState
+	}{
+		{name: "sampled caller retains state", valid: true, state: state},
+		{name: "stale state removed", valid: true},
+		{name: "invalid context removed"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := baggage.ContextWithBaggage(context.Background(), bag)
+			if test.valid {
+				ctx = trace.ContextWithSpanContext(ctx, trace.NewSpanContext(trace.SpanContextConfig{
+					TraceID: traceID, SpanID: spanID, TraceFlags: trace.FlagsSampled, TraceState: test.state,
+				}))
+			}
+			reqCtx := &RequestContext{
+				TargetEndpoint: "1.2.3.4:8080",
+				Request: &Request{Headers: map[string]string{
+					"traceparent": "old-parent", "TraceParent": "mixed-case-old-parent",
+					"tracestate": "vendor=old", "baggage": "secret=client-value",
+					"Baggage": "secret=mixed-case", "x-user-data": "preserved",
+				}},
+				Response: &Response{},
+			}
+			mutation := (&StreamingServer{}).generateRequestHeaderResponse(ctx, reqCtx).GetRequestHeaders().GetResponse().GetHeaderMutation()
+			values := make(map[string][]string)
+			for _, header := range mutation.SetHeaders {
+				key := strings.ToLower(header.GetHeader().GetKey())
+				values[key] = append(values[key], string(header.GetHeader().GetRawValue()))
+				if key == "traceparent" || key == "tracestate" {
+					assert.Equal(t, configPb.HeaderValueOption_OVERWRITE_IF_EXISTS_OR_ADD, header.AppendAction)
+				}
+			}
+			assert.Equal(t, []string{"preserved"}, values["x-user-data"])
+			assert.NotContains(t, values, "baggage")
+			assert.Contains(t, mutation.RemoveHeaders, "baggage")
+			if test.valid {
+				assert.Equal(t, []string{"00-" + traceID.String() + "-" + spanID.String() + "-01"}, values["traceparent"])
+				assert.NotContains(t, mutation.RemoveHeaders, "traceparent")
+			} else {
+				assert.NotContains(t, values, "traceparent")
+				assert.Contains(t, mutation.RemoveHeaders, "traceparent")
+			}
+			if test.state.Len() > 0 {
+				assert.Equal(t, []string{test.state.String()}, values["tracestate"])
+				assert.NotContains(t, mutation.RemoveHeaders, "tracestate")
+			} else {
+				assert.NotContains(t, values, "tracestate")
+				assert.Contains(t, mutation.RemoveHeaders, "tracestate")
+			}
+		})
+	}
 }
 
