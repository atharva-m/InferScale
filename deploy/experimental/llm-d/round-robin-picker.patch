+// Package roundrobin implements cyclic endpoint selection within one picker instance.
+package roundrobin
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strconv"
+	"sync"
+
+	fwkplugin "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/plugin"
+	fwksched "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/scheduling"
+	"github.com/llm-d/llm-d-router/pkg/epp/framework/plugins/scheduling/picker"
+)
+
+// RoundRobinPickerType is the registered name of the cyclic picker plugin.
+const RoundRobinPickerType = "round-robin-picker"
+
+var _ fwksched.Picker = &RoundRobinPicker{}
+
+// RoundRobinPickerFactory defines the factory function for RoundRobinPicker.
+func RoundRobinPickerFactory(name string, rawParameters *json.Decoder, _ fwkplugin.Handle) (fwkplugin.Plugin, error) {
+	parameters := picker.PickerParameters{MaxNumOfEndpoints: picker.DefaultMaxNumOfEndpoints}
+	if rawParameters != nil {
+		if err := rawParameters.Decode(&parameters); err != nil {
+			return nil, fmt.Errorf("failed to parse the parameters of the '%s' picker - %w", RoundRobinPickerType, err)
+		}
+	}
+	return NewRoundRobinPicker(parameters.MaxNumOfEndpoints).WithName(name), nil
+}
+
+// NewRoundRobinPicker initializes a new RoundRobinPicker.
+func NewRoundRobinPicker(maxNumOfEndpoints int) *RoundRobinPicker {
+	if maxNumOfEndpoints <= 0 {
+		maxNumOfEndpoints = picker.DefaultMaxNumOfEndpoints
+	}
+	return &RoundRobinPicker{
+		typedName:         fwkplugin.TypedName{Type: RoundRobinPickerType, Name: RoundRobinPickerType},
+		maxNumOfEndpoints: maxNumOfEndpoints,
+	}
+}
+
+// RoundRobinPicker maintains a cursor per plugin instance, not across EPP replicas.
+type RoundRobinPicker struct {
+	typedName         fwkplugin.TypedName
+	maxNumOfEndpoints int
+	mu                sync.Mutex
+	lastKey           string
+}
+
+// WithName sets the name before the picker serves requests.
+func (p *RoundRobinPicker) WithName(name string) *RoundRobinPicker {
+	p.typedName.Name = name
+	return p
+}
+
+// TypedName returns the type and name tuple of this plugin instance.
+func (p *RoundRobinPicker) TypedName() fwkplugin.TypedName {
+	return p.typedName
+}
+
+type candidate struct {
+	key      string
+	endpoint *fwksched.ScoredEndpoint
+}
+
+// Pick selects cyclic successors in stable endpoint order, ignoring scores.
+func (p *RoundRobinPicker) Pick(_ context.Context, scoredEndpoints []*fwksched.ScoredEndpoint) *fwksched.ProfileRunResult {
+	candidates := make([]candidate, 0, len(scoredEndpoints))
+	for _, endpoint := range scoredEndpoints {
+		if endpoint == nil || endpoint.Endpoint == nil || endpoint.GetMetadata() == nil {
+			continue
+		}
+		metadata := endpoint.GetMetadata()
+		key := metadata.NamespacedName.Namespace + "\x00" + metadata.NamespacedName.Name + "\x00" +
+			metadata.Address + "\x00" + metadata.Port + "\x00" + strconv.Itoa(metadata.RankIndex)
+		candidates = append(candidates, candidate{key: key, endpoint: endpoint})
+	}
+	// Candidate order belongs to the scheduler; sorting a private slice avoids
+	// changing another profile's input or racing concurrent requests.
+	sort.Slice(candidates, func(i, j int) bool { return candidates[i].key < candidates[j].key })
+	unique := candidates[:0]
+	for _, candidate := range candidates {
+		if len(unique) == 0 || candidate.key != unique[len(unique)-1].key {
+			unique = append(unique, candidate)
+		}
+	}
+	candidates = unique
+	count := min(p.maxNumOfEndpoints, len(candidates))
+	result := &fwksched.ProfileRunResult{TargetEndpoints: make([]fwksched.Endpoint, 0, count)}
+	if count == 0 {
+		return result
+	}
+
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	// A key cursor survives removals and insertions without retaining old pools
+	// or applying an index to a differently ordered candidate set.
+	start := sort.Search(len(candidates), func(i int) bool { return candidates[i].key > p.lastKey })
+	for offset := range count {
+		selected := candidates[(start+offset)%len(candidates)]
+		result.TargetEndpoints = append(result.TargetEndpoints, selected.endpoint)
+		p.lastKey = selected.key
+	}
+	return result
+}
